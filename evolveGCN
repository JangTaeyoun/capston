# 2) 시점별 인접행렬(스냅샷) 생성 (EvolveGCN용)
# ------------------------------------------------
def normalize_sparse_adj(i_idx, v_vals, num_nodes, add_self_loops=True):
    adj = torch.sparse_coo_tensor(i_idx, v_vals, (num_nodes, num_nodes)).coalesce()
    if add_self_loops:
        diag_idx = torch.arange(num_nodes, dtype=torch.long)
        di = torch.stack([diag_idx, diag_idx])
        dv = torch.ones(num_nodes, dtype=torch.float32, device=v_vals.device)
        eye = torch.sparse_coo_tensor(di, dv, (num_nodes, num_nodes)).coalesce()
        adj = (adj + eye).coalesce()

    row_sums = torch.sparse.sum(adj, dim=1).to_dense().clamp_min(1e-6)
    vals = adj.values() / row_sums[adj.indices()[0]]
    adj = torch.sparse_coo_tensor(adj.indices(), vals, adj.size()).coalesce()
    return adj


def build_timewise_adjs(dataset, num_nodes, device='cpu'):
    times = dataset.timestamps.astype(int)
    T = int(times.max()) + 1
    adjs = []
    for t in range(T):
        mask = (times == t)
        if mask.sum() == 0:
            idx = torch.arange(num_nodes, dtype=torch.long)
            i_idx = torch.stack([idx, idx])
            v_vals = torch.ones(num_nodes, dtype=torch.float32)
            adjs.append(torch.sparse_coo_tensor(i_idx, v_vals, (num_nodes, num_nodes)).coalesce().to(device))
            continue

        s = dataset.src_nodes[mask]
        d = dataset.dst_nodes[mask]
        rows = np.concatenate([s, d])
        cols = np.concatenate([d, s])
        vals = np.ones_like(rows, dtype=np.float32)

        i_idx = torch.tensor([rows, cols], dtype=torch.long)
        v_vals = torch.tensor(vals, dtype=torch.float32)
        adj = normalize_sparse_adj(i_idx, v_vals, num_nodes, add_self_loops=True).to(device)
        adjs.append(adj)
    return adjs  # list of length T


# ------------------------------------------------
# 3) EvolveGCN (H-스타일 근사)
# ------------------------------------------------
class EvolveGCNHLayer(nn.Module):
    def __init__(self, in_dim, out_dim, state_dim=128, dropout=0.5, summary='mean'):
        super().__init__()
        self.in_dim = in_dim
        self.out_dim = out_dim
        self.state_dim = state_dim
        self.summary = summary

        self.gru = nn.GRUCell(in_dim, state_dim)
        self.state = nn.Parameter(torch.randn(state_dim) * 0.1)
        self.weight_gen = nn.Linear(state_dim, in_dim * out_dim)
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.LayerNorm(out_dim)

    def summarize(self, H):
        return H.mean(dim=0)

    def forward(self, H_prev, adj):
        z_t = self.summarize(H_prev)
        S_prev = self.state.unsqueeze(0)
        S_t = self.gru(z_t.unsqueeze(0), S_prev)
        W_flat = self.weight_gen(S_t.squeeze(0))
        W_t = W_flat.view(self.in_dim, self.out_dim)

        # [BF16 오류 방지] sparse.mm은 .float() 강제
        if adj.is_sparse:
             with torch.cuda.amp.autocast(enabled=False):
                support = torch.sparse.mm(adj.float(), H_prev.float())
        else:
            support = torch.mm(adj, H_prev.float())
            
        H_t = support @ W_t
        H_t = F.relu(H_t)
        H_t = self.norm(H_t)
        H_t = self.dropout(H_t)
        return H_t, S_t.squeeze(0)


class EvolveGCNOnly(nn.Module):
    def __init__(self, node_feat_dim=10, hidden_dim=64, out_dim=64, state_dim=128, dropout=0.5):
        super().__init__()
        self.x_proj = nn.Linear(node_feat_dim, hidden_dim)
        self.evolve = EvolveGCNHLayer(hidden_dim, out_dim, state_dim=state_dim, dropout=dropout)
        self.edge_pred = nn.Sequential(
            nn.Linear(2*out_dim, 32),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(32, 16),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(16, 1)
        )
        self.register_buffer("state_cache", torch.zeros(state_dim))

    def reset_sequence(self):
        with torch.no_grad():
            self.state_cache.copy_(self.evolve.state.detach())

    def step(self, H_prev, adj):
        H_t, S_t = self.evolve(H_prev, adj)
        with torch.no_grad():
            self.state_cache.copy_(S_t)
        return H_t

    def forward_edge_logits(self, H_t, src_idx, dst_idx):
        src_h = H_t[src_idx]
        dst_h = H_t[dst_idx]
        z = torch.cat([src_h, dst_h], dim=-1)
        return self.edge_pred(z).squeeze(-1)


