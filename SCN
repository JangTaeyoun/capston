# -----------------------------
# 5. SCN Layer (희소/밀집 adj 지원) + [수정] EdgeDrop
# -----------------------------
class SourceBasedSCNLayer(nn.Module):
    # [수정] dropout 0.4 -> 0.5, edge_drop (유지)
    def __init__(self, in_dim, out_dim, dropout=0.5, edge_drop=0.2):
        super().__init__()
        self.linear = nn.Linear(in_dim, out_dim)
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.LayerNorm(out_dim)
        self.edge_drop = edge_drop # [유지]

    def forward(self, x, adj):
        if x.dim() != 2:
            x = x.view(x.size(0), -1)

        if hasattr(adj, "is_sparse") and adj.is_sparse:
            adj = adj.coalesce()
            
            # [유지] EdgeDrop (Train 시에만 적용)
            vals = adj.values()
            if self.training and self.edge_drop > 0:
                m = (torch.rand_like(vals) > self.edge_drop).float()
                # 기댓값 보존을 위한 스케일링
                vals = vals * m * (m.numel() / m.sum().clamp(min=1.))
            
            # EdgeDrop이 적용된 adj
            adj_w_drop = torch.sparse_coo_tensor(adj.indices(), vals, adj.size(), device=adj.device)
            # ---
            
            if adj_w_drop.dtype != torch.float32:
                 adj_w_drop = adj_w_drop.float()
                 
            orig_dtype = x.dtype
            if x.is_cuda:
                with torch.cuda.amp.autocast(False):
                    support = torch.sparse.mm(adj_w_drop, x.float())
            else:
                support = torch.sparse.mm(adj_w_drop, x.to(torch.float32))
            support = support.to(orig_dtype)
        else:
            if adj.shape[0] == adj.shape[1] and torch.allclose(
                adj, torch.eye(adj.shape[0], device=adj.device, dtype=adj.dtype)
            ):
                support = x
            else:
                support = torch.mm(adj, x)

        out = self.linear(support)
        out = self.norm(out)
        return self.dropout(F.relu(out))


# ------------------------------------------------
# 6. 전체 모델 (SCN Only로 수정)
# ------------------------------------------------
class SourceBased_SCN_SocialViral(nn.Module):
    def __init__(self, num_nodes, node_feat_dim, scn_in_dim=24, scn_out_dim=12):
        super().__init__()
        self.num_nodes = num_nodes
        
        # SCN을 위한 노드 피처 임베딩 (node_feat_dim -> scn_in_dim)
        self.node_proj = nn.Linear(node_feat_dim, scn_in_dim) 
        
        # SCN 레이어 (scn_in_dim -> scn_out_dim)
        self.scn = SourceBasedSCNLayer(scn_in_dim, scn_out_dim, dropout=0.5, edge_drop=0.2)

        # SCN 출력(scn_out_dim) 2개를 받아 예측
        self.edge_pred = nn.Sequential(
            nn.Linear(2 * scn_out_dim, 32), # 2 * 12 = 24
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(32, 16),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(16, 1)
        )

    def forward(self, src, dst, node_features, adj):
        # 1. 노드 피처 임베딩
        node_embs = self.node_proj(node_features) # (N, scn_in_dim)
        node_embs = F.relu(node_embs)
        
        # 2. SCN 레이어 통과
        scn_out = self.scn(node_embs, adj) # (N, scn_out_dim)

        # 3. SCN에서 임베딩 추출
        src_emb_scn = scn_out[src] # (B, scn_out_dim)
        dst_emb_scn = scn_out[dst] # (B, scn_out_dim)

        # 4. 최종 예측
        logits = self.edge_pred(torch.cat([src_emb_scn, dst_emb_scn], dim=-1)).squeeze(-1)
        
        return logits
    
    # reset_memory (TGN 전용) 함수 삭제


